# ---- infrastructure ----
POSTGRES_USER=lens
# Letters, digits and underscores only: it also goes into a URL and through Make. For example: openssl rand -hex 24
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=lens
NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://lens:change_me_local_only@localhost:5432/lens?sslmode=disable

# ---- gateway ----
GATEWAY_ADDR=:8080
ALLOWED_ORIGINS=localhost:5173,localhost:8080,localhost:8088

# ---- feeder ----
FEED_SOURCE=synthetic
FEED_VESSELS=2000
FEED_HZ=1
FEED_SEED=42

# ---- gateway (Phase 2) ----
LIVE_TICK_MS=100
HISTORY_HOURS=6

# ---- feeder (Phase 3) ----
# FEED_SOURCE=ais switches to the replay source.
# File name inside data/. make fetch-ais fetches one, Compose reads it from /data.
AIS_FILE=AIS_2024_07_01.csv
# minLon,minLat,maxLon,maxLat (US West Coast)
AIS_BBOX=-126,32,-116,49
# 10 = ten times faster than real time
REPLAY_SPEED=1
# 1 to 4: number of copies of every vessel
FANOUT=1

# ---- gateway (Phase 3) ----
# Below this zoom the server sends clusters
CLUSTER_ZOOM=6
MAX_CLIENTS=200
# Enables /ws?slow_ms=N. Set false on a public host.
ALLOW_DEBUG_PARAMS=true
